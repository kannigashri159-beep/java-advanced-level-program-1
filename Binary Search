class Main {
    public static void main(String[] args) {

        int[] a = {10, 20, 30, 40, 50};
        int key = 30;

        int low = 0, high = 4;
        boolean found = false;

        while(low <= high) {

            int mid = (low + high) / 2;

            if(a[mid] == key) {
                found = true;
                break;
            }
            else if(a[mid] < key) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }

        if(found)
            System.out.println("Found");
        else
            System.out.println("Not Found");
    }
}
