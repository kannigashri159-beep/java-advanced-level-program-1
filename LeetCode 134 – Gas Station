import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] gas = new int[n];
        int[] cost = new int[n];

        for (int i = 0; i < n; i++)
            gas[i] = sc.nextInt();

        for (int i = 0; i < n; i++)
            cost[i] = sc.nextInt();

        int total = 0, tank = 0, start = 0;

        for (int i = 0; i < n; i++) {
            total += gas[i] - cost[i];
            tank += gas[i] - cost[i];

            if (tank < 0) {
                start = i + 1;
                tank = 0;
            }
        }

        System.out.println(total >= 0 ? start : -1);
    }
}

 input:
5
1 2 3 4 5
3 4 5 1 2


Output:
3
