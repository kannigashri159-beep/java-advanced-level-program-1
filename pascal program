import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int rowIndex = sc.nextInt();

        List<Integer> a = new ArrayList<>();
        a.add(1);

        for (int i = 1; i <= rowIndex; i++) {
            a.add(1);

            for (int j = i - 1; j > 0; j--) {
                a.set(j, a.get(j) + a.get(j - 1));
            }
        }

        System.out.println(a);
    }
}
Input

3
Output

[1, 3, 3, 1]

